          "coherence_score": 0.5998287503634138,
          "explanation": "coherence/argument_quality averaged (readability removed)"
        },
        "conclusion_id": "S2",
        "conclusion_text": "La mancata imposizione dell’uso dei DPI da parte del preposto e la rimozione, da parte di un operaio, degli elementi di fissaggio del ponteggio configurano, ai sensi dell’art. 437 c.p., l’omissione dolosa di cautele contro gli infortuni sul lavoro, reato punito con la reclusione da sei mesi a cinque anni e, se dal fatto deriva un infortunio, con la reclusione da tre a dieci anni. Tale condotta, essendo finalizzata a garantire la sicurezza dei lavoratori, rientra nella fattispecie di “omissione di cautele” prevista dal medesimo articolo.",
        "libro": "CP Libro II",
        "link_id": "S1->S2",
        "nesso_intrinsic": 0.6873646407714468,
        "nesso_plausibility": 0.4891646407714468,
        "norm_support": 0.7781088913245535,
        "norm_support_details": {
          "citation_count": 1,
          "citation_count_score": 0.5773502691896257,
          "citation_score": 0.6830127018922193,
          "citation_specificity_score": 1.0,
          "final": 0.7781088913245535,
