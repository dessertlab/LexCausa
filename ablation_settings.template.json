{
  "endpoint": "http://127.0.0.1:8000/api/pipeline",
  "timeout_sec": 1800,
  "max_retries": 3,
  "retry_backoff_sec": 20,
  "include_precedents": true,
  "max_statutes": 100,
  "max_precedents": 5,
  "settings": {
    "reasoner_model": "gpt_oss_120b",
    "counter_model": "gpt_oss_120b",
    "llm_temperature": 0.3,
    "llm_max_tokens": 3500,
    "chain_min_steps": 3,
    "chain_max_steps": 6,
    "search_min_kept_statutes": 10,
    "aqa_alpha": 0.3,
    "aqa_beta": 0.4,
    "aqa_gamma": 0.3,
    "aqa_min_semantic_overlap": 0.35,
    "aqa_min_strength_ratio": 0.2,
    "aqa_damage_factor": 0.4,
    "aqa_allow_factual_attacks": true,
    "aqa_allow_cross_codice": false,
    "aqa_strength_ratio_by_type": {
      "contradiction": 0.05,
      "exception": 0.05,
      "derogation": 0.0,
      "extinction": 0.0,
      "factual_impediment": 0.55,
      "general_opposition": 0.55
    },
    "enable_causality": true,
    "reasoner_enable_causality": true,
    "counter_enable_causality": false,
    "counter_pass_taxonomy_attacks": false,
    "counter_pass_norms": false
  }
}
